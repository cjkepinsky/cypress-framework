{
  "name": "cypress-framework",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean:reports": "rimraf cypress/reports",
    "demo:open": "cross-env NODE_ENV=demo cypress open",
    "demo:run": "npm run clean:reports && cross-env NODE_ENV=demo cypress run",
    "generate-report": "rimraf cypress/reports/output.json cypress/reports/html && mochawesome-merge \"cypress/reports/mochawesome*.json\" --overwrite > cypress/reports/output.json && marge cypress/reports/output.json -o cypress/reports/html",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "postinstall": "simple-git-hooks"
  },
  "engines": {
    "node": "^20.1.0 || ^22.0.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjkepinsky/cypress-framework.git"
  },
  "author": "Krzysztof Kepinski",
  "license": "AGPL",
  "bugs": {
    "url": "https://github.com/cjkepinsky/cypress-framework/issues"
  },
  "homepage": "https://github.com/cjkepinsky/cypress-framework#readme",
  "description": "Simple example of test automation framework, based on Cypress.",
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@cypress/webpack-preprocessor": "^6.0.2",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.15.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-plugin-cypress": "^3.3.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.11.1",
    "ts-loader": "^8.4.0",
    "typescript": "^5.5.3",
    "webpack": "^4.47.0"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1"
  }
}
